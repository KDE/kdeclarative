#: qmlcontrols/kquickcontrols/ColorButton.qml:67
#, kde-format
msgctxt "@info:whatsthis for a button"
msgid "Color button"
msgstr "Дугме боје"

#: qmlcontrols/kquickcontrols/ColorButton.qml:69
#, kde-format
msgctxt "@info:whatsthis for a button of current color code %1"
msgid "Current color is %1. This button will open a color chooser dialog."
msgstr "Текућа боја је %1. Ово дугме отвара дијалог бирача боја."

#: qmlcontrols/kquickcontrols/ColorButton.qml:70
#, kde-format
msgctxt "@info:whatsthis for a button of current color code %1"
msgid "Current color is %1."
msgstr "Текућа боја је %1."

#: qmlcontrols/kquickcontrols/KeySequenceItem.qml:184
#, kde-format
msgctxt "What the user inputs now will be taken as the new shortcut"
msgid "Input"
msgstr "унесите..."

#: qmlcontrols/kquickcontrols/KeySequenceItem.qml:185
#, kde-format
msgctxt "No shortcut defined"
msgid "None"
msgstr "ниједна"

#: qmlcontrols/kquickcontrols/KeySequenceItem.qml:196
#, kde-format
msgid ""
"Click on the button, then enter the shortcut like you would in the program.\n"
"Example for Ctrl+A: hold the Ctrl key and press A."
msgstr ""
"Кликните на дугме, па унесите пречицу као што бисте у програму.\n"
"Примјер за Ctrl+A: држите тастер Ctrl и притисните A."

#: qmlcontrols/kquickcontrols/KeySequenceItem.qml:239
#, kde-format
msgctxt "@info:tooltip"
msgid "Clear Key Sequence"
msgstr "Очисти комбинацију тастера"

#: qmlcontrols/kquickcontrols/KeySequenceItem.qml:256
#, kde-format
msgctxt "@info:tooltip"
msgid "Cancel Key Sequence Recording"
msgstr "Откажи снимање комбинације тастера"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:121
#, kde-format
msgid "Reserved Shortcut"
msgstr "Резервисана пречица"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:123
#, kde-format
msgid ""
"The F12 key is reserved on Windows, so cannot be used for a global "
"shortcut.\n"
"Please choose another one."
msgstr ""
"Тастер F12 је резервисан на Виндоузу, па се не може користити као глобална "
"пречица.\n"
"Изаберите неку другу."

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:145
#, kde-format
msgid "Global Shortcut Shadowing"
msgstr "Засјењивање глобалних пречица"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:148
#, kde-format
msgid "The '%1' key combination is shadowed by following global actions:\n"
msgstr "Комбинацију тастера %1 засјењују сљедеће глобалне радње:\n"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:150
#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:156
#, kde-format
msgid "Action '%1' in context '%2'\n"
msgstr "Радња „%1“ у контексту „%2“\n"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:154
#, kde-format
msgid "The '%1' key combination shadows following global actions:\n"
msgstr "Комбинација тастера %1 засјењује сљедеће глобалне радње:\n"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:165
#, kde-format
msgctxt "@dialog:title"
msgid "Found Conflict"
msgstr "Нађен сукоб"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:170
#, kde-format
msgid ""
"Shortcut '%1' is already assigned to action '%2' of %3.\n"
"Do you want to reassign it?"
msgstr ""
"Пречица %1 је већ додијељена радњи „%2“ програма %3.\n"
"Желите ли да је поново додијелите?"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:175
#, kde-format
msgid "Shortcut '%1' is already assigned to the following actions:\n"
msgstr "Пречица %1 је већ додијељена сљедећим радњама:\n"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:177
#, kde-format
msgid "Action '%1' of %2\n"
msgstr "Радња „%1“ програма %2\n"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:179
#, kde-format
msgid "Do you want to reassign it?"
msgstr "Желите ли да је поново додијелите?"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:195
#, kde-format
msgid "Conflict with Standard Application Shortcut"
msgstr "Сукоб са стандардном програмском пречицом"

#: qmlcontrols/kquickcontrols/private/keysequencevalidator.cpp:197
#, kde-format
msgid ""
"The '%1' key combination is also used for the standard action \"%2\" that "
"some applications use.\n"
"Do you really want to use it as a global shortcut as well?"
msgstr ""
"Комбинација тастера %1 већ је додијељена стандардној радњи „%2“, коју "
"користе неки програми.\n"
"Желите ли заиста да је користите и као глобалну пречицу?"
